{
  "name": "yaha-craft",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "author": "YaHa Craft Family",
  "description": "呀哈造物 · 乌萨奇小屋造物之旅",
  "scripts": {
    "desktop:build": "node scripts/build-desktop.mjs",
    "package": "pnpm package:windows",
    "package:windows": "node scripts/package-windows.mjs",
    "package:portable": "node scripts/package-windows.mjs --portable",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview"
  },
  "build": {
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "electronDist": "node_modules/electron/dist",
    "appId": "craft.yaha.desktop",
    "productName": "呀哈造物",
    "directories": {
      "output": ".artifacts/windows"
    },
    "files": [
      {
        "from": ".artifacts/web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".artifacts/desktop",
        "to": "desktop",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": ".artifacts/python",
        "to": "python"
      },
      {
        "from": "config",
        "to": "config"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/art/usagi/app-icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "portable": {
      "artifactName": "YaHa-Craft-${version}-Windows.exe"
    },
    "nsis": {
      "artifactName": "YaHa-Craft-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "呀哈造物",
      "uninstallDisplayName": "呀哈造物",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
